# ===== ResearchPilot 前端环境变量 =====
# 所有 VITE_* 变量会注入前端构建；后端服务各自也有 .env（见 services/*、api/）。

# 文献阅读 AI 的 provider：mock（本地演示，无后端）或 http（走教学后端）
VITE_AI_PROVIDER=http
# http provider 的基础地址 —— 教学后端提供 /api/literature/* 与 /api/experiment/*
VITE_API_BASE_URL=http://127.0.0.1:8002

# 教学设计后端（可选覆盖，默认 127.0.0.1:8002）
VITE_TEACHING_API_URL=http://127.0.0.1:8002

# 科研实验 Streamlit（可选覆盖，默认 127.0.0.1:8501）
VITE_RESEARCH_STREAMLIT_URL=http://127.0.0.1:8501

# 课程案例：原「星图学航」自适应 STEM 学习路径服务
VITE_COURSE_CASE_URL=http://127.0.0.1:8800/app/
