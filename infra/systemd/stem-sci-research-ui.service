[Unit]
Description=STEM-SCI teaching research UI
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/stem-sci/STEM-SCI-repo/integrations/StarMap-Voyage/services/research
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/stem-sci/STEM-SCI-repo/integrations/StarMap-Voyage/services/research
Environment=DEEPSEEK_API_KEY=
ExecStart=/opt/stem-sci/venv-starmap/bin/streamlit run frontend/app.py --server.address 127.0.0.1 --server.port 8501 --server.headless true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
