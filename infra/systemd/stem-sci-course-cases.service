[Unit]
Description=STEM-SCI course cases API
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/stem-sci/STEM-SCI-repo/integrations/StarMap-Voyage/services/course-cases/backend
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/stem-sci/teaching.env
ExecStart=/opt/stem-sci/venv-starmap/bin/python -m uvicorn api_server:app --host 127.0.0.1 --port 8800
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
