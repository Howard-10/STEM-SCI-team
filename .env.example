# Local development settings only. Do not put credentials in this file.
STEM_SCI_ENV=development
STEM_SCI_LOG_LEVEL=INFO
STEM_SCI_CONFIG_STRICT=false
STEM_SCI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STEM_SCI_MAX_UPLOAD_BYTES=52428800

# Context source. `hybrid` is only usable when the declared local Physics-STEM
# corpus assets pass their manifest checks. It is fail-closed for formal use
# until a verified source-locator index is published.
# Agent evidence review uses the declared Physics-STEM vector corpus by
# default. Set this to local only when the project SQLite evidence is the
# intended source.
STEM_SCI_CONTEXT_PROVIDER=hybrid
STEM_SCI_GRAPH_BACKEND=auto
STEM_SCI_REQUIRE_FULL_CHAIN=false
# Bound one optional dense-embedding request; timeout degrades to BM25/graph.
STEM_SCI_RETRIEVAL_TIMEOUT_SECONDS=5
# STEM_SCI_REPOSITORY_ROOT=<local-repository-root>
# DASHSCOPE_API_KEY=<local-query-embedding-key>
# Optional local asset overrides (keep corpus files outside Git):
# STEM_SCI_VECTOR_KB_ROOT=C:\path\to\vector_kb
# STEM_SCI_PDF_ROOT=C:\path\to\literature_pdfs

# Optional local GPT runtime. Keep STEM_SCI_LLM_API_KEY in the shell or an ignored .env.local.
STEM_SCI_LLM_PROVIDER=gpt
# DeepSeek-compatible example:
# STEM_SCI_LLM_BASE_URL=https://api.deepseek.com
# STEM_SCI_LLM_MODEL=deepseek-chat
STEM_SCI_LLM_BASE_URL=https://api.openai.com/v1
STEM_SCI_LLM_MODEL=<set-for-local-deployment>
STEM_SCI_LLM_TIMEOUT_SECONDS=60
# Optional: auto, json_schema, or json_object
# STEM_SCI_LLM_RESPONSE_FORMAT=auto
# Neo4j graph navigation:
# STEM_SCI_GRAPH_BACKEND=neo4j
# NEO4J_URI=bolt://localhost:7688
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=<local-neo4j-password>
# NEO4J_DATABASE=neo4j
# NEO4J_PROJECT_ID=stem-sci
STEM_SCI_MAX_LLM_CALLS=12

# External scholarly discovery fallback. OpenAlex is free for bounded metadata
# search and needs no API key. Results remain candidates until source-verified.
STEM_SCI_EXTERNAL_SEARCH_PROVIDER=openalex
STEM_SCI_EXTERNAL_SEARCH_TIMEOUT_SECONDS=5
# Optional email for the providers' polite pool/rate-limit contact.
# STEM_SCI_EXTERNAL_SEARCH_EMAIL=you@example.com

# Optional research-code execution adapters.  Do not configure either until
# their local installation, licensing and human approval workflow are ready.
STEM_SCI_CODEX_COMMAND=codex
# `deterministic` is the CI-safe default. Set to `codex` only after the local
# Codex CLI is installed, executable, and authenticated. A Codex-generated
# artifact still requires a code-review gate and the analysis-execution approval.
STEM_SCI_CODING_PROVIDER=deterministic
# When using an OpenAI-compatible Codex proxy, set this to a profile name
# under %CODEX_HOME% and confirm a real generation probe first.
# STEM_SCI_CODEX_PROFILE=stem-sci-proxy
# STEM_SCI_CODEX_GENERATION_CONFIRMED=false
# STEM_SCI_SPSS_EXECUTABLE=C:\Program Files\IBM\SPSS\Statistics\stats.exe
STEM_SCI_WRITING_REVIEWER_ENABLED=false

# Optional separately deployed LoRA coordinator; failures fall back silently.
STEM_SCI_LLM_COORDINATOR_ENABLED=false
STEM_SCI_LLM_COORDINATOR_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2
STEM_SCI_LLM_COORDINATOR_MODEL=xsp593b8e4f
STEM_SCI_LLM_COORDINATOR_API_KEY=
STEM_SCI_LLM_COORDINATOR_TIMEOUT_SECONDS=10
